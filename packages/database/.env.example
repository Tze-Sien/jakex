# Supabase PostgreSQL Connection String
# Get this from your Supabase project: Settings > Database > Connection string
# Use the "URI" format and replace [YOUR-PASSWORD] with your database password

# For direct connection (use for migrations and local development):
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Alternative: Transaction mode (recommended for serverless/edge functions):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
