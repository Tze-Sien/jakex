# LLM Provider API Keys
GROQ_API_KEY=your_groq_api_key_here

# LLM Service Configuration (Optional - these are defaults)
LLM_CACHE_TTL_MS=3600000                    # 1 hour
LLM_MAX_RETRIES=3
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_MS=60000          # 1 minute

# Rate Limiting (Groq: 30 req/min by default)
LLM_GROQ_RATE_LIMIT=30

# Observability (optional)
LLM_ENABLE_TRACING=true
LLM_LOG_LEVEL=info                          # debug | info | warn | error
